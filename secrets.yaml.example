# Copy to secrets.yaml and fill in. secrets.yaml is git-ignored.
wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"

# 4-digit password from the Aromatic app (factory default on the tested unit: 0000)
aromatic_password: "0000"

# Diffuser BLE MAC — find it with probe-1-scan.yaml
aromatic_mac: "AA:BB:CC:DD:EE:FF"

# Generate with: openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"
